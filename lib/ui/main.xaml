<!--
  Tabula Rasa: главное окно выбора. Логика — в lib\gui.ps1 (Show-SelectionDialog), стили — в theme.xaml.
  Три колонки: навигация по категориям / карточки текущей категории / подробности выделенного.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabula Rasa" Width="1200" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== шапка: три зоны, которые не перекрываются ===== -->
        <!-- слева — значок, название, чипы (сжимаются из gui.ps1 Update-HostChips); по центру — режим; справа — поиск и действия -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel x:Name="HeadLeft" ClipToBounds="True" Margin="0,0,16,0" LastChildFill="True">
                    <Image x:Name="Logo" DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Text="Tabula Rasa" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ItemsControl x:Name="HostChips" Margin="10,0,0,0" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Pill}" ToolTip="{Binding Tip}" MaxWidth="{Binding MaxWidth}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"
                                                   Visibility="{Binding HasIcon, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <!-- режим окна: установка (каталог) или снятие настроек с этого компьютера -->
                <Border Grid.Column="1" Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}"
                        Background="{DynamicResource Control}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabInstall" GroupName="Tab" Style="{StaticResource Segment}" Content="Установка" Height="30" Padding="12,0"
                                     IsChecked="True" ToolTip="Программы, настройки Windows и файлы для этого компьютера"/>
                        <RadioButton x:Name="TabCapture" GroupName="Tab" Style="{StaticResource Segment}" Content="Снятие настроек" Height="30" Padding="12,0"
                                     ToolTip="Сохранить настройки программ этого компьютера в «Мои данные»"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="SearchBox" Width="300" Margin="0,0,8,0">
                        <TextBox x:Name="Search" AutomationProperties.Name="Поиск" Padding="32,0,32,0" Tag="Поиск по всему…"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="14" Margin="12,0,0,0"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"/>
                        <Border x:Name="SearchKey" Style="{StaticResource Kbd}" HorizontalAlignment="Right" Margin="0,0,8,0" IsHitTestVisible="False">
                            <TextBlock Text="Ctrl+F" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="SearchClear" AutomationProperties.Name="Очистить поиск" HorizontalAlignment="Right" Width="24" MinWidth="24" Height="24" Padding="0" Margin="0,0,4,0"
                                Background="Transparent" BorderThickness="0" Focusable="False" Visibility="Collapsed" ToolTip="Очистить (Esc)">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10"/>
                        </Button>
                    </Grid>
                    <Button x:Name="AddAppBtn" Padding="12,0" Margin="0,0,8,0" MinWidth="0" AutomationProperties.Name="Добавить программу"
                            ToolTip="Добавить программу из winget в собственный каталог («Мои данные»)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="12"/>
                            <TextBlock x:Name="AddAppText" Text="Программа" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SetBtn" Padding="12,0" Margin="0,0,8,0" ToolTip="Сохранённые наборы галочек: открыть, сохранить, переименовать, удалить (Ctrl+S — сохранить)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SetBtnText" Text="Сохранения" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SetMenu" Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>
                    <!-- светлая / тёмная тема (выбор запоминается; «Тема как в Windows» — в меню «⋯») -->
                    <Button x:Name="ThemeBtn" Style="{StaticResource IconButton}" Margin="0,0,4,0" AutomationProperties.Name="Переключить тему"
                            ToolTip="Переключить тему">
                        <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="14"/>
                    </Button>
                    <!-- откат, о программе, клавиши -->
                    <Button x:Name="MoreBtn" Style="{StaticResource IconButton}" AutomationProperties.Name="Ещё" ToolTip="Откат изменений, о программе, клавиши (F1)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" FontSize="14"/>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"/>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== три колонки ===== -->
        <Grid x:Name="InstallPane" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- навигация; «Итог» прибит снизу, чтобы был виден без прокрутки -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="Nav" Padding="8,0,8,8" ItemContainerStyle="{StaticResource NavItem}"
                         KeyboardNavigation.TabNavigation="Once"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="8">
                    <ListBox x:Name="NavBottom" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once"/>
                </Border>
                <!-- Мои данные: свой приватный репозиторий с сохранениями и настройками программ -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DataIcon" Style="{StaticResource Glyph}" Text="&#xE753;" Margin="0,0,10,0" Foreground="{DynamicResource TextMuted}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Мои данные" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DataStatus" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="DataBtn" Grid.Column="2" Padding="10,0" MinWidth="0" Margin="8,0,0,0">
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Top"/>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                        <!-- вход в GitHub: код с устройства -->
                        <StackPanel x:Name="DataLogin" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Введите код на странице входа GitHub (код скопирован в буфер обмена):"/>
                            <TextBox x:Name="DataCode" IsReadOnly="True" Margin="0,6,0,0" FontFamily="Consolas" FontSize="18" HorizontalContentAlignment="Center"/>
                            <Button x:Name="DataOpen" Content="Открыть страницу входа" Margin="0,8,0,0" Style="{StaticResource AccentButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- список -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- уведомление: загружено, сохранено, чего нет в каталоге -->
                    <Border x:Name="Notice" Grid.Row="0" Margin="24,16,24,0" Padding="12,0,4,0" MinHeight="40" CornerRadius="6"
                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentText}" BorderThickness="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NoticeIcon" Style="{StaticResource Glyph}" Text="&#xE73E;" Margin="0,0,10,0" Foreground="{DynamicResource AccentText}"/>
                            <TextBlock x:Name="NoticeText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8"/>
                            <Button x:Name="NoticeClose" AutomationProperties.Name="Скрыть уведомление" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Скрыть">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="24,16,24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ListTitle" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="ListHint" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel x:Name="CatButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- трёхпозиционная: все / часть / ни одного; щелчок — отметить всё или снять всё -->
                            <CheckBox x:Name="CatCheck" Content="Выбрать всё" IsThreeState="True" VerticalAlignment="Center"
                                      ToolTip="Отметить или снять все пункты категории (вариант «с моими настройками» не включается)"/>
                        </StackPanel>
                    </Grid>
                    <!-- фильтры по статусу программ (lib\status.ps1); видны в разделе «Программы» и в поиске -->
                    <StackPanel x:Name="FilterBar" Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,8" Visibility="Collapsed">
                        <CheckBox x:Name="FilterMissing" Content="Не установленные" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FilterUpdates" Content="Есть обновления" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <Button x:Name="MarkUpdates" Content="Отметить обновления" Visibility="Collapsed"
                                ToolTip="Отметить все программы, для которых есть обновление: они будут обновлены через winget"/>
                        <TextBlock x:Name="StatusScan" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="List" Grid.Row="3" Padding="24,0,16,16" ItemContainerStyle="{StaticResource CardItem}"
                             KeyboardNavigation.TabNavigation="Once">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="4,16,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                    <TextBlock x:Name="ListEmpty" Grid.Row="3" Style="{StaticResource Muted}" Margin="24,8" TextWrapping="Wrap"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
                    <!-- «Файлы» без списка: «Мои данные» не подключены, загрузка, файлов нет, ошибка (Update-FilesCard в gui.ps1) -->
                    <Border x:Name="FilesCard" Grid.Row="3" Margin="24,8,24,16" Padding="24" MaxWidth="560" CornerRadius="8"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FilesCardIcon" Style="{StaticResource Glyph}" FontSize="24" Margin="0,2,16,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentText}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="FilesCardTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FilesCardText" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                                <Button x:Name="FilesCardBtn" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- подробности -->
            <Grid Grid.Column="2">
                <!-- пустое состояние: ничего не выделено -->
                <StackPanel x:Name="DetailHint" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="Выберите пункт" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,24"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Kbd}" HorizontalAlignment="Right"><TextBlock Text="Пробел" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="отметить" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Border Grid.Row="1" Style="{StaticResource Kbd}" HorizontalAlignment="Right"><TextBlock Text="Ctrl+F" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="поиск" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Border Grid.Row="2" Style="{StaticResource Kbd}" HorizontalAlignment="Right"><TextBlock Text="Esc" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="очистить поиск" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Border Grid.Row="3" Style="{StaticResource Kbd}" HorizontalAlignment="Right"><TextBlock Text="Ctrl+1 / 2 / 3" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="разделы" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Border Grid.Row="4" Style="{StaticResource Kbd}" HorizontalAlignment="Right"><TextBlock Text="↑ / ↓" VerticalAlignment="Center"/></Border>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="категории" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid Margin="24">
                        <StackPanel x:Name="Detail" Visibility="Collapsed">
                            <!-- шапка: плитка как в карточке, название, раздел, статус на этом компьютере -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="40" Height="40" Margin="0,2,12,0" VerticalAlignment="Top" Visibility="{Binding HasTile, Converter={StaticResource Vis}}">
                                    <Border CornerRadius="8" Background="{Binding MonoBrush}">
                                        <TextBlock Text="{Binding Monogram}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border CornerRadius="8" Background="{DynamicResource Surface}" Visibility="{Binding HasIcon, Converter={StaticResource Vis}}">
                                        <Image Source="{Binding IconSource}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Title}"/>
                                    <TextBlock Text="{Binding CatName}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,4,0,0" Foreground="{DynamicResource AccentText}"
                                               Visibility="{Binding HasStatus, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,4,0,0">
                                <Border Style="{StaticResource Pill}" Margin="0,4,4,0"
                                        Visibility="{Binding OpenSource, Converter={StaticResource Vis}}" ToolTip="Открытый исходный код">
                                    <TextBlock Text="Open source" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource Pill}" Margin="0,4,4,0"
                                        Visibility="{Binding IsMine, Converter={StaticResource Vis}}" ToolTip="Программа из собственного каталога («Мои данные»)">
                                    <TextBlock Text="мой каталог" VerticalAlignment="Center"/>
                                </Border>
                                <Border Style="{StaticResource DangerPill}" Margin="0,4,4,0" Visibility="{Binding Irreversible, Converter={StaticResource Vis}}">
                                    <TextBlock Text="необратимо" VerticalAlignment="Center"/>
                                </Border>
                            </WrapPanel>
                            <CheckBox Content="Отмечено" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding FullDesc}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>

                            <!-- установленная программа (Э7): что с ней сделать при применении -->
                            <StackPanel Margin="0,24,0,0" Visibility="{Binding IsLocked, Converter={StaticResource Vis}}">
                                <TextBlock Text="Программа установлена" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <Border Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}"
                                        Background="{DynamicResource Control}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="Act" Style="{StaticResource Segment}" Content="Оставить" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ActKeep, Mode=TwoWay}" ToolTip="Не трогать установленную программу"/>
                                        <RadioButton GroupName="Act" Style="{StaticResource Segment}" Content="Обновить" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ActUpdate, Mode=TwoWay}" IsEnabled="{Binding CanUpdate}"
                                                     ToolTip="Обновить до последней версии через winget" ToolTipService.ShowOnDisabled="True"/>
                                        <RadioButton GroupName="Act" Style="{StaticResource Segment}" Content="Переустановить" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ActReinstall, Mode=TwoWay}" ToolTip="Установить заново поверх установленной"/>
                                        <RadioButton GroupName="Act" Style="{StaticResource Segment}" Content="Удалить" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ActRemove, Mode=TwoWay}" IsEnabled="{Binding CanRemove}"
                                                     ToolTip="Удалить программу через winget. Вернуть её можно только установкой заново" ToolTipService.ShowOnDisabled="True"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"
                                           Text="Отметка установленной программы не снимается. Чтобы применить к ней сохранённые настройки, выберите «С моими настройками» ниже."/>
                            </StackPanel>

                            <!-- установка: сегмент «Чистая | С моими настройками» -->
                            <StackPanel x:Name="Install" Margin="0,24,0,0" Visibility="{Binding HasConfig, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding ConfigLabel}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                                <Border Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}"
                                        Background="{DynamicResource Control}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="Install" Style="{StaticResource Segment}" Content="{Binding ConfigOffText}" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ConfigOff, Mode=TwoWay}" ToolTip="Как после обычной установки, без переноса настроек"/>
                                        <RadioButton x:Name="RbMine" GroupName="Install" Style="{StaticResource Segment}" Content="С моими настройками" Height="30" Padding="12,0"
                                                     IsChecked="{Binding ConfigOn, Mode=TwoWay}" IsEnabled="{Binding ConfigAvailable}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding ConfigDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                                <!-- почему «с моими» недоступно: файла настроек нет ни в своих данных, ни в движке -->
                                <TextBlock Text="{Binding ConfigHint}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0" Foreground="{DynamicResource TextMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConfigAvailable}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Facts}" Margin="0,16,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
                                            <TextBlock x:Name="V" Text="{Binding Value}" TextWrapping="Wrap" LineHeight="20" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="danger">
                                                <Setter TargetName="V" Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tone}" Value="mono">
                                                <Setter TargetName="V" Property="FontFamily" Value="Consolas"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RemoveMine" Content="Удалить из моего каталога…" HorizontalAlignment="Left" Margin="0,24,0,0"
                                    Visibility="{Binding IsMine, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== снятие настроек: программы этого компьютера → «Мои данные» (логика — Update-Capture в gui.ps1) ===== -->
        <Grid x:Name="CapturePane" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,16,24,8">
                        <TextBlock Text="Снятие настроек" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="CaptureHint" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ListBox x:Name="CaptureList" Grid.Row="1" Padding="24,0,16,16" ItemContainerStyle="{StaticResource CardItem}"
                             KeyboardNavigation.TabNavigation="Once"/>
                    <Border x:Name="CaptureCard" Grid.Row="1" Margin="24,8,24,16" Padding="24" MaxWidth="560" CornerRadius="8"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CaptureCardIcon" Style="{StaticResource Glyph}" FontSize="24" Margin="0,2,16,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentText}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CaptureCardTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CaptureCardText" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0"/>
                                <Button x:Name="CaptureCardBtn" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!-- подробности: что снимается и что нет, последнее снятие -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="CaptureDetailHint" Text="Выберите программу" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="CaptureDetail" Margin="24" Visibility="Collapsed">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Title}"/>
                        <CheckBox Content="Снять" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding Facts}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock x:Name="V" Text="{Binding Value}" TextWrapping="Wrap" LineHeight="20" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="danger">
                                            <Setter TargetName="V" Property="Foreground" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="mono">
                                            <Setter TargetName="V" Property="FontFamily" Value="Consolas"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <Grid Margin="24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CaptureSummary" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Text="Перед записью показываются изменения; пароли, токены и ключи вырезаются."/>
                    <Button x:Name="CaptureBtn" Grid.Column="1" MinWidth="168" Content="Снять выбранное" Style="{StaticResource AccentButton}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== план, прогон, итог (gui.ps1: Show-RunPane; шаги — lib\run.ps1) ===== -->
        <Grid x:Name="RunPane" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="24,20,24,8">
                <TextBlock x:Name="RunTitle" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="RunHint" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <ProgressBar x:Name="RunProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
            </StackPanel>
            <!-- нужна перезагрузка -->
            <Border x:Name="RunBanner" Grid.Row="1" Margin="24,4,24,8" Padding="16,10" CornerRadius="6" Visibility="Collapsed"
                    Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentText}" BorderThickness="1">
                <DockPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE777;" Foreground="{DynamicResource AccentText}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Для завершения изменений нужна перезагрузка компьютера. Перезагрузить его можно кнопкой «Перезагрузить» внизу окна." VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="RunList" Padding="24,0,16,16" KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="4,16,0,6"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="6" Margin="0,0,0,4" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="G" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14"
                                                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Note}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Irreversible}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock x:Name="D" Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="S" Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="wait">
                                                <Setter TargetName="S" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="run">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="G" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                <Setter TargetName="S" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="done">
                                                <Setter TargetName="G" Property="Foreground" Value="{DynamicResource AccentText}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="error">
                                                <Setter TargetName="G" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                <Setter TargetName="S" Property="Foreground" Value="{DynamicResource Danger}"/>
                                                <Setter TargetName="D" Property="Foreground" Value="{DynamicResource Danger}"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                    <Grid Margin="24,0,24,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- выполнить вручную: отметки сохраняются (logs\manual_<дата>.json) -->
                        <StackPanel x:Name="ManualBox" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Выполнить вручную" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ManualList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DockPanel Grid.Row="1" Margin="0,16,0,0">
                            <Button x:Name="LogToggle" DockPanel.Dock="Top" Content="Показать журнал" HorizontalAlignment="Left"/>
                            <TextBox x:Name="RunLog" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     AcceptsReturn="True" Visibility="Collapsed" AutomationProperties.Name="Журнал выполнения"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="24,16" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RunBack" Content="Назад к выбору" Margin="8,0,0,0"/>
                        <Button x:Name="RunSkip" Content="Пропустить текущий" Margin="8,0,0,0" ToolTip="Снять текущую установку и перейти к следующему шагу"/>
                        <Button x:Name="RunStop" Content="Остановить после текущего" Margin="8,0,0,0"/>
                        <Button x:Name="RunRetry" Content="Повторить упавшее" Margin="8,0,0,0"/>
                        <Button x:Name="RunOpenLog" Content="Журналы" Margin="8,0,0,0" ToolTip="Открыть папку журналов выполнения и изменений"/>
                        <Button x:Name="RunOpenReport" Content="Открыть отчёт" Margin="8,0,0,0" ToolTip="Открыть отчёт о прогоне в браузере"/>
                        <Button x:Name="RunOpenFolder" Content="Открыть папку" Margin="8,0,0,0" ToolTip="Открыть папку с отчётами"/>
                        <Button x:Name="RunReboot" Content="Перезагрузить" Margin="8,0,0,0" ToolTip="Перезагрузить компьютер"/>
                        <Button x:Name="RunApply" Content="Применить…" MinWidth="152" Margin="8,0,0,0" Style="{StaticResource AccentButton}"/>
                        <Button x:Name="RunClose" Content="Закрыть" MinWidth="120" Margin="8,0,0,0" Style="{StaticResource AccentButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="RunStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== низ: одна строка ===== -->
        <Border x:Name="InstallBar" Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PcNameLabel" Text="Имя ПК" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="PcName" AutomationProperties.Name="Новое имя компьютера" Grid.Column="1" Width="144" MaxLength="15" Tag="не менять"
                         ToolTip="Латинские буквы, цифры и дефис, не более 15 символов. Пустое поле — имя не меняется"/>
                <!-- в домене вместо поля: имя меняется только доменной учётной записью, Tabula Rasa его не трогает -->
                <TextBlock x:Name="PcNameFixed" Grid.ColumnSpan="2" VerticalAlignment="Center" Visibility="Collapsed"
                           ToolTip="Компьютер в домене: переименование требует доменной учётной записи, поэтому имя не меняется">
                    <Run Text="Имя ПК:"/> <Run x:Name="PcNameCur" FontWeight="SemiBold"/><Run Text="  ·  в домене, не меняется" Foreground="{DynamicResource TextMuted}"/>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="Режим" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <Border Grid.Column="3" Height="32" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}"
                        Background="{DynamicResource Control}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModePlan" GroupName="Mode" Style="{StaticResource Segment}" Content="План" Height="30" Padding="12,0"
                                     ToolTip="Показать, что будет сделано, без изменений в системе"/>
                        <RadioButton x:Name="ModeApply" GroupName="Mode" Style="{StaticResource Segment}" Content="Применить" Height="30" Padding="12,0"
                                     ToolTip="Применить изменения. Перед запуском запрашивается подтверждение"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Summary" Grid.Column="4" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,16,0"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="SaveBtn" Grid.Column="5" Content="Сохранить…" Margin="0,0,8,0" ToolTip="Сохранить текущие галочки (Ctrl+S)"/>
                <Button x:Name="OkBtn" Grid.Column="6" MinWidth="152" IsDefault="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
