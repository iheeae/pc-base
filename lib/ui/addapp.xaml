<!--
  Tabula Rasa: «Добавить программу» — поиск в winget и запись в собственный каталог (Show-AddAppDialog в lib\gui.ps1).
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabula Rasa — добавить программу" Width="760" Height="600" MinWidth="640" MinHeight="480" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="24,24,24,8">
            <TextBlock Text="Добавить программу" Style="{StaticResource Title}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"
                       Text="Поиск выполняется в winget по названию, идентификатору и тегам. Программа добавляется в собственный каталог в «Моих данных» и появляется в окне на всех компьютерах."/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Query" Tag="Название программы на английском, например notepad plus, 7zip, obs"/>
                <Button x:Name="Find" Grid.Column="1" Content="Найти" MinWidth="96" Margin="8,0,0,0" IsDefault="True"/>
            </Grid>
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Results" Padding="24,0,8,16">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,0,0,4" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="Pick" Margin="16,0,24,16" Visibility="Collapsed">
                    <TextBlock x:Name="PickName" Style="{StaticResource Title}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PickId" FontFamily="Consolas" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PickInfo" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock Text="Описание" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <TextBox x:Name="PickDesc" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="64" VerticalContentAlignment="Top" Padding="8,6"/>
                    <TextBlock Text="Категория" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <TextBox x:Name="PickCat"/>
                    <TextBlock x:Name="PickCats" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                <Button x:Name="Add" Content="Добавить" MinWidth="120" Style="{StaticResource AccentButton}" IsEnabled="False"/>
                <Button x:Name="Cancel" Content="Отмена" MinWidth="120" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
