<!--
  pc-base: короткое сообщение или подтверждение (Show-UiMessage в lib\gui.ps1). Текст и кнопки — из кода.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pc-base" Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <StackPanel>
        <StackPanel Margin="24,24,24,24">
            <TextBlock x:Name="Head" Style="{StaticResource Title}"/>
            <StackPanel x:Name="Body" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,16">
                <Button x:Name="Primary" MinWidth="120" Style="{StaticResource AccentButton}"/>
                <Button x:Name="Secondary" MinWidth="120" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
