<!--
  Tabula Rasa: окошко «что скачать с Диска» (Show-FilePicker в lib\gui.ps1) — когда в главном окне Диск ещё не был виден.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabula Rasa — файлы с Диска" Width="600" Height="640" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="24,24,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Что скачать с Диска" Style="{StaticResource Title}"/>
                <TextBlock Text="Файлы копируются в папку «Рабочий стол\pc-base-exe» без установки." Style="{StaticResource Caption}"
                           Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="All" Content="Всё" Margin="0,0,8,0"/>
                <Button x:Name="None" Content="Нет"/>
            </StackPanel>
        </Grid>
        <ListBox x:Name="List" Grid.Row="1" Padding="24,8,16,16" ItemContainerStyle="{StaticResource CardItem}"/>
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="Skip" Grid.Column="1" Content="Пропустить" Margin="16,0,8,0" IsCancel="True"/>
                <Button x:Name="Ok" Grid.Column="2" Content="Скачать" MinWidth="120" Style="{StaticResource AccentButton}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
