    Apps = @(
        @{ Id = 'git';       Name = 'Git'; Desc = 'Система контроля версий. Используется Tabula Rasa для получения обновлений.'; OpenSource = $true; Category = 'Основа'; Source = 'winget'; WingetId = 'Git.Git'; Scope = 'machine'; Note = 'Требуется Tabula Rasa для обновлений'; Config = @{ File = 'git\gitconfig'; From = @('%USERPROFILE%\.gitconfig'); Export = 'Export-GitConfig'; Import = 'Set-GitConfig'; Desc = 'Глобальный файл .gitconfig: имя и почта для коммитов, псевдонимы, параметры по умолчанию.'; Skip = 'Разделы [credential] и заголовки http.extraheader. Вход в GitHub на целевом компьютере сохраняется.' } }
        @{ Id = 'gh';        Name = 'GitHub CLI'; Desc = 'Консольный клиент GitHub: вход в учётную запись, клонирование приватных репозиториев, работа с issues.'; OpenSource = $true; Category = 'Основа'; Source = 'winget'; WingetId = 'GitHub.cli'; Scope = 'machine'; Note = 'Нужен для подключения «Моих данных»' }
        @{ Id = 'pwsh';      Appx = 'Microsoft.PowerShell'; Name = 'PowerShell 7'; Desc = 'Современная версия PowerShell. Устанавливается рядом с Windows PowerShell 5.1, работает быстрее и корректно использует UTF-8.'; OpenSource = $true; Category = 'Основа'; Source = 'winget'; WingetId = 'Microsoft.PowerShell'; Scope = 'machine'; Config = @{ File = 'pwsh_profile.ps1'; From = @('{MyDocuments}\PowerShell\Microsoft.PowerShell_profile.ps1'); Export = 'Export-PwshConfig'; Import = 'Set-PwshProfile'; Desc = 'Профиль PowerShell 7 (Microsoft.PowerShell_profile.ps1). Заменяет встроенный профиль Tabula Rasa.'; Skip = 'Строки, похожие на пароли и токены, и история команд.' } }
        @{ Id = 'wt';        Appx = 'Microsoft.WindowsTerminal'; Name = 'Windows Terminal'; Desc = 'Терминал с вкладками, панелями и выдвижной консолью по сочетанию клавиш. В Windows 11 установлен по умолчанию.'; OpenSource = $true; Category = 'Основа'; Source = 'winget'; WingetId = 'Microsoft.WindowsTerminal'; Note = 'В Windows 11 уже установлен'; Config = @{ File = 'wt\settings.json'; From = @('%LOCALAPPDATA%\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json'); Export = 'Export-TerminalConfig'; Import = 'Set-TerminalUserConfig'; Desc = 'Файл settings.json: профили, цветовые схемы, сочетания клавиш, внешний вид.'; Skip = 'Строки, похожие на пароли и токены.' } }
        @{ Id = 'vivaldi';   Name = 'Vivaldi'; Desc = 'Браузер с гибкой настройкой интерфейса. Устанавливается чистым или с сохранёнными настройками (значок ⚙, блок «Установка»).'; Category = 'Повседневное'; Source = 'winget'; WingetId = 'Vivaldi.Vivaldi'; Scope = 'machine'; Manual = 'Войти в Vivaldi Sync'; Config = @{ File = 'vivaldi\prefs.json'; From = @('%LOCALAPPDATA%\Vivaldi\User Data\Default\Preferences'); Export = 'Export-VivaldiConfig'; Import = 'Set-VivaldiConfig'; Desc = 'Настройки интерфейса, панелей, вкладок и поведения браузера.'; Skip = 'Закладки, пароли, история, расширения, почта, учётные записи и синхронизация.' } }
        @{ Id = 'everything';Name = 'Everything'; Desc = 'Мгновенный поиск файлов по имени на всех дисках по индексу NTFS, показывает размеры папок.'; Category = 'Повседневное'; Source = 'winget'; WingetId = 'voidtools.Everything'; Scope = 'machine'; Manual = 'Everything: включить размеры папок (Indexes → Index folder size)'; Config = @{ File = 'everything\Everything.ini'; From = @('%APPDATA%\Everything\Everything.ini'); Export = 'Export-EverythingConfig'; Import = 'Set-EverythingConfig'; Desc = 'Файл Everything.ini: индексируемые папки и диски, исключения, фильтры, вид окна.'; Skip = 'База индекса (строится заново) и строки, похожие на пароли.' } }
